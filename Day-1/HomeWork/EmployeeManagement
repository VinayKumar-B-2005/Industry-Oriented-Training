import java.util.Scanner;

public class EmployeeManagement {

    Scanner sc = new Scanner(System.in);

    String name;
    int age;
    String designation;
    double salary;

    public static void main(String[] args) {
        EmployeeManagement obj = new EmployeeManagement();
        int choice;

        do {
            System.out.println("\n----- MENU -----");
            System.out.println("1) Create");
            System.out.println("2) Display");
            System.out.println("3) Raise Salary");
            System.out.println("4) Exit");
            System.out.print("Enter your choice: ");
            choice = obj.sc.nextInt();

            switch (choice) {
                case 1:
                    obj.create();
                    break;
                case 2:
                    obj.display();
                    break;
                case 3:
                    obj.raiseSalary();
                    break;
                case 4:
                    System.out.println("Exiting program... Goodbye!");
                    break;
                default:
                    System.out.println("Invalid choice! Please enter 1-4.");
            }
        } while (choice != 4);
    }

    // Method to create employee record
    void create() {
        sc.nextLine();
        System.out.print("Enter the name: ");
        name = sc.nextLine();

        sc.nextInt();
        System.out.print("Enter the age: ");
        age = sc.nextInt();

        sc.nextLine();
        System.out.print("Enter the designation (P - Programmer, T - Tester, M - Manager): ");
        String code = sc.nextLine().trim().toUpperCase();

        switch (code) {
            case "P":
                designation = "Programmer";
                break;
            case "T":
                designation = "Tester";
                break;
            case "M":
                designation = "Manager";
                break;
            default:
                designation = "Not Specified";
        }
        sc.nextDouble();
        System.out.print("Enter the salary: ");
        salary = sc.nextDouble();

        System.out.println("Employee created successfully!");
    }

    // Method to display employee record
    void display() {
        if (name == null) {
            System.out.println("No employee record found. Please create one first.");
            return;
        }
        System.out.println("\n--- Employee Details ---");
        System.out.println("Name: " + name);
        System.out.println("Age: " + age);
        System.out.println("Designation: " + designation);
        System.out.println("Salary: " + salary);
    }

    // Method to raise employee salary
    void raiseSalary() {
        if (name == null) {
            System.out.println("No employee record found. Please create one first.");
            return;
        }

        System.out.print("Enter the raise percentage: ");
        double percent = sc.nextDouble();

        double increment = salary * (percent / 100);
        salary = salary + increment;

        System.out.println("Salary raised successfully!");
        System.out.println("New Salary: " + salary);
    }
}
